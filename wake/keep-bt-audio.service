[Unit]
Description=Keep Nest Hub Bluetooth A2DP + Pulse ready
After=bluetooth.service network.target
Wants=bluetooth.service

[Service]
Type=oneshot
User=past
Group=audio
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/past/antigravity-butler/wake/keep_bt_audio.sh

[Install]
WantedBy=multi-user.target
